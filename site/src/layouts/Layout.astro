---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
// Build date (Rome), shown in the footer and used to warn if the data has gone stale.
const builtDay = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit',
}).format(new Date());
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='14' font-size='14'>🎬</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/"><b>Schermo</b>Milano <span>· i film nelle sale di Milano</span></a>
        <nav class="site-nav">
          <a href="/" data-i18n="nav.films">Film</a>
          <a href="/mappa" data-i18n="nav.map">Mappa</a>
          <span class="lang-switch">
            <button type="button" data-lang-btn="it">IT</button>
            <button type="button" data-lang-btn="en">EN</button>
          </span>
        </nav>
      </div>
    </header>
    <main class="container">
      <p class="stale-notice" id="stale-notice" hidden data-i18n="stale.notice">Attenzione: gli orari non vengono aggiornati da qualche giorno e potrebbero non essere più validi. Verifica sul sito della sala.</p>
      <slot />
    </main>
    {/* Runs synchronously right after the content is parsed (before the deferred page scripts):
        the site is static, so hide anything dated before today in Rome — past days, films whose
        last showing has passed — in case the daily rebuild hasn't happened yet. */}
    <script is:inline define:vars={{ builtDay }}>
      (function () {
        var today = new Intl.DateTimeFormat('en-CA', {
          timeZone: 'Europe/Rome', year: 'numeric', month: '2-digit', day: '2-digit',
        }).format(new Date());
        document.querySelectorAll('[data-expires]').forEach(function (el) {
          if (el.getAttribute('data-expires') < today) {
            el.hidden = true;
            el.setAttribute('data-expired', '1');
          }
        });
        // More than 2 days since the last build: the daily refresh is failing — say so.
        if ((Date.parse(today) - Date.parse(builtDay)) / 864e5 > 2) {
          document.getElementById('stale-notice').hidden = false;
        }
      })();
    </script>
    <footer class="site-footer">
      <p><span data-i18n="footer.tmdb">Dati dei film da TMDB. Questo prodotto usa le API di TMDB ma non è approvato né certificato da TMDB.</span> <a href="https://www.themoviedb.org/">TMDB</a></p>
      <p data-i18n="footer.disclaimer">Orari e programmazione possono cambiare: verifica sempre sul sito della sala prima di andare.</p>
      <p><span data-i18n="footer.updated">Orari aggiornati il</span> <span data-date={builtDay}>{builtDay}</span>.</p>
    </footer>

    <script>
      import { UI } from '../lib/i18n';
      type Lang = 'it' | 'en';
      const dateFmt: Record<Lang, Intl.DateTimeFormat> = {
        it: new Intl.DateTimeFormat('it-IT', { weekday: 'long', day: 'numeric', month: 'long' }),
        en: new Intl.DateTimeFormat('en-GB', { weekday: 'long', day: 'numeric', month: 'long' }),
      };
      const dtFmt: Record<Lang, Intl.DateTimeFormat> = {
        it: new Intl.DateTimeFormat('it-IT', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }),
        en: new Intl.DateTimeFormat('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }),
      };
      // localStorage throws when storage is blocked (some private modes, strict cookie settings);
      // an uncaught throw here would kill the whole language toggle, so treat it as best-effort.
      const store = {
        get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
        set: (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* ignore */ } },
      };
      function apply(lang: Lang) {
        const dict = UI[lang];
        store.set('lang', lang);
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const v = dict[el.dataset.i18n!];
          if (v != null) el.textContent = v;
        });
        document.querySelectorAll<HTMLElement>('[data-en]').forEach((el) => {
          el.textContent = (lang === 'en' && el.dataset.en) ? el.dataset.en : (el.dataset.it ?? el.textContent ?? '');
        });
        document.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
          el.textContent = dateFmt[lang].format(new Date(el.dataset.date! + 'T00:00:00'));
        });
        document.querySelectorAll<HTMLElement>('[data-dt]').forEach((el) => {
          el.textContent = dtFmt[lang].format(new Date(el.dataset.dt!));
        });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
          const n = Number(el.dataset.n || '0');
          el.textContent = `${n} ${dict[`unit.${el.dataset.count}${n === 1 ? '' : 's'}`] ?? ''}`;
        });
        document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.langBtn === lang)));
        (window as any).__lang = lang;
        document.dispatchEvent(new CustomEvent('langchange', { detail: lang }));
      }
      const saved = store.get('lang');
      document.querySelectorAll<HTMLElement>('[data-lang-btn]').forEach((b) =>
        b.addEventListener('click', () => apply(b.dataset.langBtn as Lang)));
      apply(saved === 'en' ? 'en' : 'it');
    </script>
  </body>
</html>
