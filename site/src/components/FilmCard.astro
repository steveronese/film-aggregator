---
import type { Cinema, Film, Screening } from '../lib/data';
import { posterUrl, fmtDayTime, isOriginal, sortByStart } from '../lib/data';
import { searchKey } from '../lib/search';

interface Props {
  film: Film;
  screenings: Screening[];
  cinemas: Map<string, Cinema>;
}
const { film, screenings, cinemas } = Astro.props;

const sorted = sortByStart(screenings);
const next = sorted[0];
const dates = [...new Set(sorted.map((s) => s.start.slice(0, 10)))].join(',');
const cins = [...new Set(sorted.map((s) => s.cinema_id))].join(',');
const hasVO = sorted.some((s) => isOriginal(s.language)) ? '1' : '0';
const poster = posterUrl(film.poster_path, 'w342');
const nextCinema = next ? cinemas.get(next.cinema_id)?.name ?? next.cinema_id : '';
const n = sorted.length;

// Haystack for the client-side search box (title in both languages, original title, director,
// year). Normalized at build time so the filter is a cheap substring test.
const search = searchKey(film.title, film.title_en, film.original_title, film.italian_title, film.director, film.year);
---

<a
  class="film-card"
  href={`/film/${film.tmdb_id}`}
  data-dates={dates}
  data-cinemas={cins}
  data-vo={hasVO}
  data-search={search}
>
  <div class="poster">
    {poster
      ? <img src={poster} alt={`Locandina di ${film.title}`} loading="lazy" />
      : <div class="poster-fallback">{film.title}</div>}
    {hasVO === '1' && <span class="badge" data-i18n="lang.ov">VO</span>}
  </div>
  <h3 data-it={film.title} data-en={film.title_en ?? film.title}>{film.title}</h3>
  <p class="sub">{[film.year, film.director].filter(Boolean).join(' · ')}</p>
  {next && (
    <p class="next"><span data-count="screening" data-n={n}>{n} proiezion{n === 1 ? 'e' : 'i'}</span> · <b data-dt={next.start}>{fmtDayTime(next.start)}</b> · {nextCinema}</p>
  )}
</a>
